# --- Estágio 1: Builder ---
FROM golang:1.26.2-bookworm AS builder

# Instala dependências de compilação para o driver Confluent (CGO)
RUN apt-get update && apt-get install -y --no-install-recommends \
  gcc \
  libc-dev \
  pkg-config \
  librdkafka-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Otimização de Cache: Baixa dependências antes de copiar o código fonte
COPY go.mod go.sum ./
RUN go mod download

# Copia código fonte
COPY . .

# Build de alta performance:
# - CGO_ENABLED=1: Necessário para librdkafka
# - ldflags="-s -w": Remove tabelas de símbolos (binário menor)
RUN CGO_ENABLED=1 GOOS=linux go build \
  -ldflags="-s -w" \
  -o /app/order-producer ./cmd/order-producer/main.go

# --- Estágio 2: Runner (Final) ---
FROM gcr.io/distroless/base-debian12 AS runner

WORKDIR /app

# Copia o binário compilado
COPY --from=builder /app/order-producer .

# Copia bibliotecas compartilhadas necessárias para o librdkafka
# Incluímos libssl e libcrypto para garantir suporte a conexões seguras/autenticadas
COPY --from=builder /usr/lib/x86_64-linux-gnu/librdkafka* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /usr/lib/x86_64-linux-gnu/libssl.so* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /usr/lib/x86_64-linux-gnu/libcrypto.so* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /usr/lib/x86_64-linux-gnu/libsasl2.so* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /usr/lib/x86_64-linux-gnu/libzstd.so* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /usr/lib/x86_64-linux-gnu/liblz4.so* /usr/lib/x86_64-linux-gnu/

# Configurações de execução
ENV PORT=4000
EXPOSE $PORT

# Distroless não tem shell, então o formato JSON é obrigatório
# O usuário 'nonroot' já vem criado na imagem distroless
USER nonroot:nonroot

ENTRYPOINT ["./order-producer"]
