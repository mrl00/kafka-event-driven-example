# check=skip=UndefinedVar
# =============================================================================
# Estágio 1: Builder
# =============================================================================
FROM golang:1.26.2-bookworm AS builder

# Instala dependências de compilação para o driver Confluent (CGO)
RUN apt-get update && apt-get install -y --no-install-recommends \
  gcc \
  libc-dev \
  pkg-config \
  librdkafka-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Otimização de cache: baixa dependências antes de copiar o código fonte
COPY go.mod go.sum ./
RUN go mod download

# CORRIGIDO: copia apenas os pacotes necessários ao producer
# (evita invalidar cache por mudanças em arquivos não relacionados)
COPY internal/ ./internal/
COPY cmd/order-producer/ ./cmd/order-producer/
COPY cmd/healthcheck/ ./cmd/healthcheck/

# Build de produção:
# - CGO_ENABLED=1: necessário para librdkafka
# - ldflags="-s -w": remove tabelas de símbolos (binário menor)
RUN CGO_ENABLED=1 GOOS=linux go build \
  -ldflags="-s -w" \
  -o /app/order-producer ./cmd/order-producer/main.go

# Healthcheck binário estático (sem CGO para distroless)
RUN CGO_ENABLED=0 GOOS=linux go build \
  -ldflags="-s -w" \
  -o /app/healthcheck ./cmd/healthcheck/main.go

# Coleta as libs dinâmicas necessárias em tempo de build
# usando ldd para ser agnóstico à arquitetura (x86_64, arm64, etc.)
RUN mkdir /libs && \
  ldd /app/order-producer \
  | grep "=> /" \
  | awk '{print $3}' \
  | xargs -I{} cp --no-dereference {} /libs/ && \
  # Copia também os symlinks para garantir resolução correta
  ldd /app/order-producer \
  | grep "=> /" \
  | awk '{print $3}' \
  | xargs -I{} sh -c 'ls -la $(dirname {}) | grep $(basename {}) | grep "^l" | awk "{print \$9}" | xargs -I@ cp --no-dereference $(dirname {})/@  /libs/ 2>/dev/null || true'

# =============================================================================
# Estágio 2: Runner (Distroless)
# =============================================================================
FROM gcr.io/distroless/base-debian12 AS runner

WORKDIR /app

# Copia os binários compilados
COPY --from=builder /app/order-producer .
COPY --from=builder /app/healthcheck .

# CORRIGIDO: copia libs coletadas dinamicamente via ldd
# Isso garante compatibilidade com qualquer arquitetura (x86_64, arm64, etc.)
COPY --from=builder /libs/ /usr/lib/

# Configurações de execução
ENV HTTP_PORT=${HTTP_PORT:-4000}
EXPOSE $HTTP_PORT

# Distroless não tem shell: formato JSON é obrigatório no ENTRYPOINT
# O usuário 'nonroot' já vem criado na imagem distroless
USER nonroot:nonroot

ENTRYPOINT ["./order-producer"]
