# =============================================================================
# Estágio 1: Builder
# =============================================================================
FROM golang:1.26.2-bookworm AS builder

# Instala dependências necessárias para compilar o driver do Kafka (CGO)
RUN apt-get update && apt-get install -y --no-install-recommends \
  gcc \
  libc-dev \
  pkg-config \
  librdkafka-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Otimização de cache: baixa dependências antes de copiar o código fonte
COPY go.mod go.sum ./
RUN go mod download

# Copia apenas os pacotes necessários ao consumer
COPY internal/ ./internal/
COPY cmd/order-consumer/ ./cmd/order-consumer/

# Build otimizado para produção
# CGO_ENABLED=1 é obrigatório para consumidores que usam librdkafka
RUN CGO_ENABLED=1 GOOS=linux go build \
  -ldflags="-s -w" \
  -o /app/order-consumer ./cmd/order-consumer/main.go

# Coleta as libs dinâmicas necessárias em tempo de build
# usando ldd para ser agnóstico à arquitetura (x86_64, arm64, etc.)
RUN mkdir /libs && \
  ldd /app/order-consumer \
  | grep "=> /" \
  | awk '{print $3}' \
  | xargs -I{} cp --no-dereference {} /libs/ && \
  ldd /app/order-consumer \
  | grep "=> /" \
  | awk '{print $3}' \
  | xargs -I{} sh -c 'ls -la $(dirname {}) | grep $(basename {}) | grep "^l" | awk "{print \$9}" | xargs -I@ cp --no-dereference $(dirname {})/@  /libs/ 2>/dev/null || true'

# =============================================================================
# Estágio 2: Runner (Distroless)
# =============================================================================
FROM gcr.io/distroless/base-debian12 AS runner

WORKDIR /app

# Copia o binário do estágio builder
COPY --from=builder /app/order-consumer .

# CORRIGIDO: copia libs coletadas dinamicamente via ldd
# Isso garante compatibilidade com qualquer arquitetura (x86_64, arm64, etc.)
COPY --from=builder /libs/ /usr/lib/

# CORRIGIDO: consumer Kafka não expõe porta HTTP
# Remova as linhas abaixo caso o consumer não tenha endpoint HTTP/healthcheck
# Se houver endpoint de métricas (ex: Prometheus), adicione a porta correta aqui
# ENV PORT=4000
# EXPOSE $PORT

# Roda com usuário não-privilegiado (padrão da imagem distroless)
USER nonroot:nonroot

# Entrypoint direto (sem shell)
ENTRYPOINT ["./order-consumer"]
