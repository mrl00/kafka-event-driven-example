# Example .env file for kafka-event-driven-example

# Comma-separated list of Kafka brokers (required)
KAFKA_BROKERS=localhost:29092,localhost:39092,localhost:49092

# Kafka topic name (default: orders)
KAFKA_TOPIC=orders

# Kafka consumer group ID (consumer only; default: order-consumer-group)
KAFKA_GROUP_ID=order-consumer-group

# Partition count for topic (default: 3)
KAFKA_NUM_PARTITIONS=3

# Replication factor for topic (default: 3)
KAFKA_REPLICATION_FACTOR=3

# HTTP server port (default: 4000)
HTTP_PORT=4000

# HTTP server timeouts (Go duration format: 15s, 1m, etc.)
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_READ_HEADER_TIMEOUT=5s

# Graceful shutdown timeout (default: 30s)
SHUTDOWN_TIMEOUT=30s
